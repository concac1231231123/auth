# Cổng chạy local
PORT=3000

# Mật khẩu quản trị Owner (bắt buộc đổi để bảo mật)
ADMIN_SECRET=owner_secret_123456

# Cấu hình Discord Bot (lấy tại https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_bot_application_id_here
DISCORD_OWNER_ID=your_personal_discord_user_id_here

# (Tùy chọn) URL Database đám mây nếu deploy Serverless Netlify
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
